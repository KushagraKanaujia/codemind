{
  "name": "CodeMind (demo mode)",
  // Official Dev Container image: https://github.com/devcontainers/images (MIT)
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  // Install keyless demo deps for the API and the frontend's node_modules
  "postCreateCommand": "pip install --user -r backend/requirements-demo.txt && npm --prefix frontend ci",
  // Start the API (port 8000) and the UI (port 5173) every time the codespace starts
  "postStartCommand": "nohup bash scripts/dev.sh > /tmp/codemind-dev.log 2>&1 &",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "CodeMind UI", "onAutoForward": "openBrowser" },
    "8000": { "label": "CodeMind API (/docs)", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint"]
    }
  }
}
