# Demo Mode - No Real API Keys Required
# These are dummy keys that won't work but let the app start

ANTHROPIC_API_KEY=sk-ant-demo-mode-no-real-key-needed
OPENAI_API_KEY=sk-demo-mode-no-real-key-needed

# Supabase - not needed for demo
SUPABASE_URL=https://demo.supabase.co
SUPABASE_KEY=demo-key

# Application
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Settings
API_V1_PREFIX=/api/v1
MAX_SEARCH_RESULTS=10
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
